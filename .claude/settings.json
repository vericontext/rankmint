{
  "permissions": {
    "allow": [
      "Bash(python3 output/*)",
      "Bash(python3 templates/*)",
      "Bash(mkdir -p output/*)",
      "Bash(pip install *)",
      "Bash(pip3 install *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Bash executed: $TOOL_INPUT\" >> /tmp/rankmint-log.txt"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"$NOTIFICATION_MESSAGE\" with title \"RankMint\"' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
